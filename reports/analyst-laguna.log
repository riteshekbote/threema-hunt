=== proto IntermediateKeyStorageV1_1 fields ===
message IntermediateKeyStorageV1 {
  oneof inner {
    // A compatible, version-prefixed inner key storage without any further
    // protection
    bytes plaintext_inner = 1;

    // Inner key storage protected by the Remote Secret protocol
    RemoteSecretProtected remote_secret_protected_inner = 2;
  }
}

// Intermediate key storage V1_1, encoded in the following way:
//
// 1. Let `data` be the result of encoding this key storage to bytes.
// 2. Let `version` be the selected `IntermediateKeyStorage_Version.V1_X` version.
// 3. Return `u16-le(version) || data`.
message IntermediateKeyStorageV1_1 {
  oneof inner {
    // A compatible, version-prefixed inner key storage without any further
    // protection
    bytes plaintext_inner = 1;

    // Inner key storage protected by the Remote Secret protocol
    RemoteSecretProtected remote_secret_protected_inner = 2;
  }

  // Threema Work Credentials (if any)
  ThreemaWorkCredentials work_credentials = 3;

  // Threema OnPrem config (if any)
  OnPremConfig on_prem_config = 4;
}
