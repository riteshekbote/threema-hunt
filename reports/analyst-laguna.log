class ProtobufDecoder:
    def __init__(self, data): self.data = data; self.pos = 0
    def _read_varint(self):
        result = 0; shift = 0
        while self.pos < len(self.data):
            byte = self.data[self.pos]; self.pos += 1
            result |= (byte & 0x7F) << shift
            if (byte & 0x80) == 0: break
            shift += 7
        return result
    def _read_bytes(self):
        length = self._read_varint()
        result = self.data[self.pos:self.pos + length]; self.pos += length
        return result
    def _read_tag(self):
        if self.pos >= len(self.data): return None, None
        tag = self._read_varint()
        return tag >> 3, tag & 0x7
    def parse_fields(self):
        fields = {}
        while True:
            fn, wt = self._read_tag()
            if fn is None: break
            if wt == 0: fields.setdefault(fn, []).append(self._read_varint())
            elif wt == 2: fields.setdefault(fn, []).append(self._read_bytes())
            else: break
        return fields

