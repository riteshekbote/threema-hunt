        // Update stores.
        this._setRemoteSecretDataStoreData(initialRemoteSecretStoreData);
        this._setOnPremConfigStoreData(intermediate.onPremConfig);
        this._setWorkCredentialsStoreData(intermediate.workCredentials);

        return {
            intermediate,
            inner,
        };
    }

    /** @inheritdoc */
