import json, urllib.request

invalid_ids = ['C' + 'A' * 7 + str(i).zfill(6) for i in range(1, 4999)]
payload = json.dumps({'identities': ['ECHOECHO'] + invalid_ids}).encode()
print(f'Batch size: {len(\"identities\") if False else 5000} IDs (1 valid + 4999 invalid), payload size: {len(payload)} bytes')

req = urllib.request.Request(
    'https://ds-apip.threema.ch/identity/fetch_bulk',
    data=payload,
    headers={'Content-Type': 'application/json'},
    method='POST'
)

try:
    resp = urllib.request.urlopen(req, timeout=15)
    body = resp.read().decode()
    print(f'HTTP {resp.status}, len={len(body)}, body={body[:200]}')
except urllib.error.HTTPError as e:
    print(f'HTTP {e.code}, body={e.read().decode()[:200]}')
except Exception as e:
    print(f'Error: {e}')
