ck = secrets.token_bytes(32)
server_group = '*G'
dgk = secrets.token_bytes(32)
database_key = secrets.token_bytes(32)
device_cookie = secrets.token_bytes(16)

# Build IdentityData protobuf
def proto_string(field_num, s):
    encoded = s.encode('utf-8')
    tag = (field_num << 3) | 2
    return bytes([tag]) + bytes([len(encoded)]) + encoded

def proto_bytes(field_num, b):
    tag = (field_num << 3) | 2
    return bytes([tag]) + bytes([len(b)]) + b

def proto_varint(field_num, val):
    tag = (field_num << 3) | 0
    encoded = bytearray()
    while val > 0:
        b = val & 0x7F
        val >>= 7
        if val > 0:
            b |= 0x80
        encoded.append(b)
    return bytes([tag]) + bytes([len(encoded)]) + bytes(encoded) if False else bytes([tag]) + bytes(encoded)

# Build IdentityData
identity_data_proto = proto_string(1, identity) + proto_bytes(2, ck) + proto_string(4, server_group)
# Build InnerKeyStorageV3
inner_proto = identity_data_proto + proto_bytes(2, dgk) + proto_bytes(3, database_key)
# Add deviceIds (field 4)
device_ids_proto = proto_varint(1, 12345) + proto_varint(2, 67890)
inner_proto += proto_bytes(4, device_ids_proto)
# Add deviceCookie (field 5)
inner_proto += proto_bytes(5, device_cookie)
# Prepend version
inner_bytes = struct.pack('<H', 3) + inner_proto

# Encrypt inner with random secret (plaintext inner, no remote secret encryption)
# For testing, we'll just use the inner bytes directly as plaintextInner

# Build IntermediateKeyStorageV1_1
intermediate_proto = proto_bytes(1, inner_bytes)  # plaintextInner
# Prepend version
intermediate_bytes = struct.pack('<H', 1) + intermediate_proto

# Encrypt intermediate with XSalsa20-Poly1305
box = nacl.secret.SecretBox(key)
nonce = secrets.token_bytes(24)
encrypted_intermediate = bytes(box.encrypt(intermediate_bytes, nonce))
# encrypted_data = nonce + ciphertext (SecretBox includes nonce in the output)
# Actually, SecretBox.encrypt returns nonce + ciphertext, but we want nonce ahead format
encrypted_with_nonce_ahead = nonce + encrypted_intermediate[len(nonce):]  # remove nonce from ciphertext since box includes it

# Wait, let me check PyNaCl SecretBox.encrypt behavior
ct = box.encrypt(intermediate_bytes, nonce)
print(f'PyNaCl SecretBox.encrypt output: {len(ct)} bytes')
print(f'  First 24 bytes (nonce): {ct[:24].hex()}')
print(f'  Rest (ciphertext+MAC): {len(ct[24:])} bytes')

# For our format, EncryptedDataWithNonceAhead = nonce || ciphertext+MAC
# SecretBox.encrypt returns: nonce(24) + ciphertext+MAC
encrypted_final = ct  # This is already nonce + ciphertext+MAC

# But in the code, the format is: nonce || ciphertext (without duplicate nonce in ciphertext)
# So the EncryptedDataWithNonceAhead is just the full output from encrypt
# Actually looking at the TypeScript code, encryptWithRandomNonceAhead returns:
# _array.subarray(encryptedHeadroom) which starts at position 16, then sets nonce at start
# This gives: nonce(24) + ciphertext+MAC
# Which is the same as PyNaCl's encrypt output

# Let me verify: decrypt should work
recovered = box.decrypt(encrypted_final[24:], encrypted_final[:24])
print(f'Decryption successful: {recovered[:2]} == intermediate version {struct.unpack(\"<H\", intermediate_bytes[:2])[0]}')

# Now build OuterKeyStorageV2
# field 1: encryptedIntermediate
# field 2: kdfParameters (oneof -> argon2id at field 1)

# Build Argon2idParameters
argon_param = (
    proto_varint(1, 0) +  # version: VERSION_1_3 = 0
    proto_bytes(2, salt) +
    # For uint32 fields, use varint
    proto_bytes(3, struct.pack('<I', memory_bytes)) if memory_bytes > 127 else proto_varint(3, memory_bytes)
)
# Actually uint32 in protobuf is varint, not fixed32 (it's uint32 not fixed32)
# But wait, in the TS proto, the field is uint32. In protobuf wire format, uint32 is varint.
# But in the generated TS, the tag is 24 which is field 3 wire_type 0 (varint)
# However, memory_bytes = 128*1024*1024 which is > 127, so it needs multi-byte varint

def encode_varint(val):
    encoded = bytearray()
    while val > 0:
        b = val & 0x7F
        val >>= 7
        if val > 0:
            b |= 0x80
        encoded.append(b)
    return bytes(encoded) if len(encoded) > 0 else b'\\x00'

argon_param = (
    struct.pack('B', (1 << 3) | 0) + encode_varint(0)  # version: 0
) + (
    struct.pack('B', (2 << 3) | 2) + bytes([len(salt)]) + salt  # salt
) + (
    struct.pack('B', (3 << 3) | 0) + encode_varint(memory_bytes)  # memory_bytes
) + (
    struct.pack('B', (4 << 3) | 0) + encode_varint(iterations)  # iterations
) + (
    struct.pack('B', (5 << 3) | 0) + encode_varint(parallelism)  # parallelism
)

# field 2: kdfParameters, oneof argon2id is field 1 of the oneof
# In protobuf, a oneof with argon2id at field 1 means the outer field number is 2
# and the inner message is argon2id params
# kdfParameters is field 2, and it's a oneof where argon2id = field 1
# Actually: field 2 in OuterKeyStorageV2 is kdfParameters oneof
# The oneof has: argon2id = 1
# So we write: tag(2, len(len(argon_param)) + argon_param
# But wait, in the proto: oneof kdf_parameters { Argon2idParameters argon2id = 2; }
# So the field number for argon2id within the oneof is 2, and it's field 2 of the outer message
# No wait, looking at the proto:
# message OuterKeyStorageV2 {
#   bytes encrypted_intermediate = 1;
#   oneof kdf_parameters { Argon2idParameters argon2id = 2; }
# }
# So argon2id is field 2, wire type 2 (length-delimited)
kdf_field = struct.pack('B', (2 << 3) | 2) + bytes([len(argon_param)]) + argon_param

outer_proto = (
    struct.pack('B', (1 << 3) | 2) + bytes([len(encrypted_final)]) + encrypted_final  # encryptedIntermediate
) + kdf_field

# Prepend version
outer_bytes = struct.pack('<H', 1) + outer_proto

print(f'\\nMock keystorage.bin: {len(outer_bytes)} bytes')

