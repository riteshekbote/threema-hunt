import struct, secrets, sys

# Inline the protobuf decoder for testing
class ProtobufDecoder:
    def __init__(self, data: bytes):
        self.data = data
        self.pos = 0

    def _read_varint(self) -> int:
        result = 0
        shift = 0
        while self.pos < len(self.data):
            byte = self.data[self.pos]
            self.pos += 1
            result |= (byte & 0x7F) << shift
            if (byte & 0x80) == 0:
                break
            shift += 7
        return result

    def _read_bytes(self) -> bytes:
        length = self._read_varint()
        result = self.data[self.pos:self.pos + length]
        self.pos += length
        return result

    def _read_tag(self):
        if self.pos >= len(self.data):
            return None, None
        tag = self._read_varint()
        field_number = tag >> 3
        wire_type = tag & 0x7
        return field_number, wire_type

    def parse_fields(self) -> dict:
        fields = {}
        while True:
            field_number, wire_type = self._read_tag()
            if field_number is None:
                break
            if wire_type == 0:
                value = self._read_varint()
                fields.setdefault(field_number, []).append(value)
            elif wire_type == 2:
                value = self._read_bytes()
                fields.setdefault(field_number, []).append(value)
            elif wire_type == 5:
                value = struct.unpack('<I', self.data[self.pos:self.pos+4])[0]
                self.pos += 4
                fields.setdefault(field_number, []).append(value)
            elif wire_type == 1:
                value = struct.unpack('<Q', self.data[self.pos:self.pos+8])[0]
                self.pos += 8
                fields.setdefault(field_number, []).append(value)
            else:
                break
        return fields

identity = 'TEST1234'
ck = secrets.token_bytes(32)
server_group = '*G'
dgk = secrets.token_bytes(32)
database_key = secrets.token_bytes(32)
device_cookie = secrets.token_bytes(16)
d2m = 12345
