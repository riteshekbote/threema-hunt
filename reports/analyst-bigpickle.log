                    });
                } catch (error) {
                    throw new DirectoryError(
                        'fetch',
                        `${description} authentication fetch request errored`,
                        {
                            from: error,
                        },
                    );
                }

                // Process response
                if (response.status !== 200) {
                    throw new DirectoryError(
                        'authentication',
                        `${description} authentication fetch request returned status ${response.status}`,
