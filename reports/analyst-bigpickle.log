import socket, time, binascii

def probe(host, port=5222, timeout=4):
    try:
        s = socket.create_connection((host, port), timeout=timeout)
        s.settimeout(timeout)
        data = b""
        start = time.time()
        try:
            while time.time() - start < timeout and len(data) < 160:
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
        except socket.timeout:
            pass
        s.close()
        return data
    except Exception as e:
        return None

for label, host in [("staging", "g-00.0.test.threema.ch"), ("prod", "g-00.0.threema.ch")]:
    d = probe(host)
    if d is None:
        print(f"{label} {host}:5222 -> error/no data")
    else:
        print(f"{label} {host}:5222 -> {len(d)} bytes, first 80: {binascii.hexlify(d[:80]).decode()}")
    time.sleep(1.2)
EOF
