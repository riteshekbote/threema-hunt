            .string()
            .map((value) => base64ToU8a(value))
            .map((value) => ensurePublicKey(value)),
    })
    .rest(v.unknown());

type ChallengePayload = v.Infer<typeof CHALLENGE_PAYLOAD>;

const BULK_IDENTITIES_SCHEMA = v
    .object({
